<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>SpaceFleet</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="tools/**/*.cs" />
    <Compile Remove="shots/**/*.cs" />
    <Compile Remove="src/Sim/**/*.cs" />
    <ProjectReference Include="src/Sim/SpaceFleet.Sim.csproj" />
    <EmbeddedResource Include="assets/ships/manifest.json" LogicalName="SpaceFleet.assets.ships.manifest.json" />
  </ItemGroup>
</Project>
