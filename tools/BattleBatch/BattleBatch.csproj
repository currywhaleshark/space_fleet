<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="GodotSharp"><HintPath>../../.godot/mono/temp/bin/Debug/GodotSharp.dll</HintPath></Reference>
    <Compile Include="../../src/Sim/*.cs" Link="Sim/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../data/ships/*.json" LogicalName="SpaceFleet.data.ships.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../data/modules/*.json" LogicalName="SpaceFleet.data.modules.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../data/components/*.json" LogicalName="SpaceFleet.data.components.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../data/weapons/*.json" LogicalName="SpaceFleet.data.weapons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../data/variants/*.json" LogicalName="SpaceFleet.data.variants.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../data/tree/*.json" LogicalName="SpaceFleet.data.tree.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
